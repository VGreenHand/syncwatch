# 复制为 .env 后按需修改（.env 不入库）
# 宿主机监听端口（客户端连这个端口）
PORT=8995

# 构建用基础镜像
# 官方镜像（海外 / 能直连 Docker Hub 时用这两行）：
GO_IMAGE=golang:1.22-alpine
RUNTIME_IMAGE=alpine:3.20
# 国内服务器请换成镜像源（取消下面注释、注释掉上面两行）：
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.22-alpine
# RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.20

# Go 模块代理（国内建议 https://goproxy.cn,direct）
GOPROXY=https://proxy.golang.org,direct
