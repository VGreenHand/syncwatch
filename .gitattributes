# 默认：文本文件，仓库内与工作区统一使用 LF
* text=auto eol=lf

# Windows 批处理必须 CRLF，否则 cmd 解析异常
*.bat text eol=crlf
*.ps1 text eol=crlf

# 源码与脚本统一 LF
*.go text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.apk binary
*.exe binary
*.zip binary
