<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#3B4356" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/brand_dark"
                android:startColor="#465AC4" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/brand_purple"
                android:startColor="@color/brand_primary" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
