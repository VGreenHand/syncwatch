<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#262F49" />
            <corners android:radius="@dimen/radius_button" />
            <stroke
                android:width="1dp"
                android:color="@color/brand_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input" />
            <corners android:radius="@dimen/radius_button" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke_subtle" />
        </shape>
    </item>
</selector>
